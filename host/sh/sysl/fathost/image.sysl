module sh.sysl.fathost
@requires(os)

import sh.sysl.fat.{DeviceError, StoreDevice, store_device}
import sysl.fs

// A block device over an image file: the package's device over any positioned store, over a file.
// Writes go to the operating system as they are made, and `flush` is the file's `sync`, an fsync: a
// flush alone would hand the bytes over without asking the system to keep them. `dev.store().close()`
// hands the file back.
type ImageDevice = StoreDevice[fs.File]

// Open an existing image of `sector_size`-byte sectors; a trailing part sector is not used.
open_image(path: string, sector_size: usize = 512) -> Result[ImageDevice, DeviceError]
    val f = fs.open_update(path) match
        Ok(f) -> f
        Err(_) -> return Err(DeviceError.Io(0))
    image_of(f, sector_size)

// Make a new image of `sectors` sectors, replacing any file there. It is sparse where the host's
// filesystem allows: only the sectors written take space.
create_image(path: string, sectors: u64, sector_size: usize = 512) -> Result[ImageDevice, DeviceError]
    var f = fs.create_update(path) match
        Ok(f) -> f
        Err(_) -> return Err(DeviceError.Io(0))
    if f.truncate(long(sectors) * long(sector_size)).is_err() then return Err(DeviceError.Io(0))
    image_of(f, sector_size)

private image_of(f: fs.File, sector_size: usize) -> Result[ImageDevice, DeviceError] = store_device(f, sector_size) match
    Ok(d) -> Ok(d)
    Err(_) -> Err(DeviceError.Io(0))
