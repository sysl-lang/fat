module sh.sysl.fat

// The times a directory entry keeps, and where they come from. A volume has no clock of its own: a
// board, a kernel or the host hands it one (`Volume.set_clock`), and without one every entry is
// stamped with the earliest time FAT can hold, midnight on 1 January 1980.

// A time as a directory entry keeps it (spec section 6.2): the date as years since 1980, month and day
// in seven, four and five bits; the time as hours, minutes and two-second units in five, six and five
// bits; and, kept for the creation time alone, the hundredths of a second past those two seconds, 0-199.
struct Stamp derives Eq, Display
    date: u16
    time: u16
    hundredths: u8

// What a volume asks for the time when it stamps an entry.
trait Clock
    now(self) -> Stamp

// 1980-01-01 00:00:00, the earliest time FAT can hold: year 0, month 1, day 1.
val EPOCH: Stamp = Stamp(0x0021, 0, 0)

// The stamp of a time, given as the calendar has it. A year before 1980 is 1980 and one past 2107 is
// 2107, the years seven bits hold; the other fields are taken as they are.
fat_stamp(year: u32, month: u32, day: u32, hour: u32, minute: u32, second: u32) -> Stamp
    val y = if year < 1980 then 0u32 else if year > 2107 then 127u32 else year - 1980
    Stamp(u16(y << 9 | month << 5 | day), u16(hour << 11 | minute << 5 | second / 2), u8(second % 2 * 100))
