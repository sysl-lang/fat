module sh.sysl.fat
@tests

import sysl.buf.{Buf, buf}
import sysl.io.{ReadAt, WriteAt, read_exact_at, write_all_at}

// A RAM device whose reads, writes and flushes fail while `failing` is set.
private struct Failing
    inner: RamDevice
    failing: bool

impl BlockDevice for Failing
    sector_size(self) -> usize = self.inner.sector_size()
    sectors(self) -> u64 = self.inner.sectors()
    read(*self, s: u64, out: []u8) -> Result[unit, DeviceError]
        if self.failing then return Err(DeviceError.Io(0))
        self.inner.read(s, out)
    write(*self, s: u64, data: []const u8) -> Result[unit, DeviceError]
        if self.failing then return Err(DeviceError.Io(0))
        self.inner.write(s, data)
    flush(*self) -> Result[unit, DeviceError]
        if self.failing then return Err(DeviceError.Io(0))
        self.inner.flush()

private bytes(n: usize, seed: usize) -> Buf[u8]
    var out: Buf[u8] = buf()
    for i in 0..<n do out.push(u8((i * 31 + seed) % 253))
    out

private zeroed(n: usize) -> Buf[u8]
    var out: Buf[u8] = buf()
    for _ in 0..<n do out.push(0)
    out

@test("FileAt: bytes written at offsets read back at offsets, across sectors and clusters, and through a fresh open")
file_at_round_trip()
    var dev = ram(32768)
    format(&dev, Some(FatType.Fat16)).unwrap()
    var cache: [512]u8 = [0; 512]
    var v = mount(&dev, cache[..]).unwrap()
    var at = FileAt(&v, v.create("AT.BIN").unwrap())
    assert(at.extent().unwrap() == 0)
    val first = bytes(5000, 1)
    write_all_at(&at, 0, first.view()).unwrap()
    val patch = bytes(700, 2)
    assert(at.write_at(1000, patch.view()).unwrap() == patch.len())
    assert(at.extent().unwrap() == 5000)
    at.sync().unwrap()
    var reopened = FileAt(&v, v.open("AT.BIN").unwrap())
    val out = zeroed(5000)
    assert(read_exact_at(&reopened, 0, out.view()).unwrap().len == 5000)
    for i in 0..<5000 do assert(out[i] == (if i >= 1000 && i < 1700 then patch[i - 1000] else first[i]))
    var few: [10]u8 = [0; 10]
    val got = reopened.read_at(4995, few[..]).unwrap()
    assert(got.len == 5)
    for i in 0..<5 do assert(got[i] == first[4995 + i])

@test("FileAt: a read at or past the end answers empty, and an empty write takes nothing anywhere")
file_at_ends()
    var dev = ram(32768)
    format(&dev, Some(FatType.Fat16)).unwrap()
    var cache: [512]u8 = [0; 512]
    var v = mount(&dev, cache[..]).unwrap()
    var at = FileAt(&v, v.create("END.BIN").unwrap())
    var few: [8]u8 = [0; 8]
    assert(at.read_at(0, few[..]).unwrap().len == 0)
    write_all_at(&at, 0, bytes(100, 3).view()).unwrap()
    assert(at.read_at(100, few[..]).unwrap().len == 0)
    assert(at.read_at(0xFFFF_FFFF_FFFF, few[..]).unwrap().len == 0)
    assert(at.read_at(0, few[..<0]).unwrap().len == 0)
    assert(at.write_at(5000, []).unwrap() == 0)
    assert(at.write_at(0xFFFF_FFFF_FFFF, []).unwrap() == 0)
    assert(at.extent().unwrap() == 100)

@test("FileAt: a write past the end fills the gap with zeros first, as pwrite does")
file_at_gap()
    var dev = ram(32768)
    format(&dev, Some(FatType.Fat16)).unwrap()
    var cache: [512]u8 = [0; 512]
    var v = mount(&dev, cache[..]).unwrap()
    var at = FileAt(&v, v.create("GAP.BIN").unwrap())
    write_all_at(&at, 0, bytes(10, 4).view()).unwrap()
    val tail = bytes(20, 5)
    assert(at.write_at(3000, tail.view()).unwrap() == 20)
    assert(at.extent().unwrap() == 3020)
    val out = zeroed(3020)
    read_exact_at(&at, 0, out.view()).unwrap()
    for i in 0..<10 do assert(out[i] == bytes(10, 4)[i])
    for i in 10..<3000 do assert(out[i] == 0)
    for i in 0..<20 do assert(out[3000 + i] == tail[i])

@test("FileAt: a write past 4 GiB less one byte is TooLarge, whatever the offset, and changes nothing")
file_at_too_large()
    var dev = ram(32768)
    format(&dev, Some(FatType.Fat16)).unwrap()
    var cache: [512]u8 = [0; 512]
    var v = mount(&dev, cache[..]).unwrap()
    var at = FileAt(&v, v.create("BIG.BIN").unwrap())
    val one: [1]u8 = [1]
    assert(at.write_at(0x1_0000_0000, one[..]).err() == Some(VolumeError.TooLarge))
    assert(at.write_at(0xFFFF_FFFF, one[..]).err() == Some(VolumeError.TooLarge))
    assert(at.write_at(0xFFFF_FFFF_FFFF_FFFF, one[..]).err() == Some(VolumeError.TooLarge))
    assert(at.extent().unwrap() == 0)

@test("FileAt: a device that fails reaches the caller as VolumeError.Device from read_at, write_at and sync")
file_at_device_errors()
    var dev = Failing(ram(32768), false)
    format(&dev, Some(FatType.Fat16)).unwrap()
    var cache: [512]u8 = [0; 512]
    var v = mount(&dev, cache[..]).unwrap()
    var at = FileAt(&v, v.create("ERR.BIN").unwrap())
    write_all_at(&at, 0, bytes(4096, 6).view()).unwrap()
    at.sync().unwrap()
    dev.failing = true
    val out = zeroed(4096)
    assert(at.read_at(0, out.view()).err() == Some(VolumeError.Device(DeviceError.Io(0))))
    assert(at.write_at(0, bytes(4096, 7).view()).err() == Some(VolumeError.Device(DeviceError.Io(0))))
    assert(at.sync().err() == Some(VolumeError.Device(DeviceError.Io(0))))

@test("mount on a device that fails reading its boot sector is VolumeError.Device, as any other device failure is")
mount_device_error()
    var dev = Failing(ram(32768), false)
    format(&dev, Some(FatType.Fat16)).unwrap()
    dev.failing = true
    var cache: [512]u8 = [0; 512]
    assert(mount(&dev, cache[..]).err() == Some(VolumeError.Device(DeviceError.Io(0))))
    // A boot sector read and refused is still `Boot`.
    dev.failing = false
    val blank: [512]u8 = [0; 512]
    dev.write(0, blank[..]).unwrap()
    assert(mount(&dev, cache[..]).err() == Some(VolumeError.Boot(BootError.NoSignature)))

// Storage that lasts as long as the program, as a board's has: the volume and file handle that use it
// are module vars too, since a value in a module var may not point into a function's locals.
const PARK_SECTORS: u64 = 8500
var park_disk_a: [4352000]u8
var park_cache_a: [512]u8
var park_dev_a: RamDevice
var parked_volume: Volume[RamDevice]

var park_disk_b: [4352000]u8
var park_cache_b: [512]u8
var park_dev_b: RamDevice
var park_volume_b: Volume[RamDevice]
var parked_file: FileAt[RamDevice]

var park_disk_c: [4352000]u8
var park_cache_c: [512]u8
var park_dev_c: RamDevice
var park_volume_c: Volume[RamDevice]
var park_file_c: FileAt[RamDevice]

private unmounted_everything(v: *Volume[RamDevice])
    var e = empty_entry()
    var f = new_file(0, 0, 0, 0)
    var d = v.root()
    var out: [8]u8 = [0; 8]
    assert(!v.is_mounted())
    assert_eq(v.geometry.fat_type, FatType.Fat12)
    assert_eq(v.read_dir(&d, &e).unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.find("A.TXT", &e).unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.open("A.TXT").unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.open_dir("").unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.open_entry(&e).unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.open_dir_entry(&e).unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.read(&f, out[..]).unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.write(&f, out[..]).unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.write(&f, out[..<0]).unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.truncate(&f, 0).unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.create("A.TXT").unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.make_dir("D").unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.remove("A.TXT").unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.remove_dir("D").unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.rename("A", "B").unwrap_err(), VolumeError.NotMounted)
    assert_eq(v.flush().unwrap_err(), VolumeError.NotMounted)

@test("a Volume that is a module var is unmounted until mount's result is assigned over it, then works")
volume_module_var()
    unmounted_everything(&parked_volume)
    park_dev_a = ram_device(park_disk_a[..])
    format(&park_dev_a, Some(FatType.Fat16)).unwrap()
    parked_volume = mount(&park_dev_a, park_cache_a[..]).unwrap()
    assert(parked_volume.is_mounted())
    assert_eq(parked_volume.geometry.fat_type, FatType.Fat16)
    var f = parked_volume.create("HELLO.TXT").unwrap()
    val data = bytes(8, 1)
    assert_eq(parked_volume.write(&f, data.view()).unwrap(), 8usize)
    parked_volume.flush().unwrap()
    var g = parked_volume.open("HELLO.TXT").unwrap()
    var out: [8]u8 = [0; 8]
    assert_eq(parked_volume.read(&g, out[..]).unwrap(), 8usize)
    assert_eq(out[3], data[3])
    assert_eq(parked_volume.open("NOPE.TXT").unwrap_err(), VolumeError.NotFound)

@test("a FileAt that is a module var answers NotMounted everywhere until a real one is assigned, then works")
file_at_module_var()
    var few: [4]u8 = [0; 4]
    assert(!parked_file.is_open())
    assert_eq(parked_file.extent().unwrap_err(), VolumeError.NotMounted)
    assert_eq(parked_file.read_at(0, few[..]).unwrap_err(), VolumeError.NotMounted)
    assert_eq(parked_file.write_at(0, few[..]).unwrap_err(), VolumeError.NotMounted)
    assert_eq(parked_file.write_at(0, few[..<0]).unwrap_err(), VolumeError.NotMounted)
    assert_eq(parked_file.sync().unwrap_err(), VolumeError.NotMounted)
    park_dev_b = ram_device(park_disk_b[..])
    format(&park_dev_b, Some(FatType.Fat16)).unwrap()
    park_volume_b = mount(&park_dev_b, park_cache_b[..]).unwrap()
    parked_file = FileAt(&park_volume_b, park_volume_b.create("AT.BIN").unwrap())
    assert(parked_file.is_open())
    val data = bytes(4, 2)
    assert_eq(parked_file.write_at(0, data.view()).unwrap(), 4usize)
    assert_eq(parked_file.extent().unwrap(), 4u64)
    assert_eq(parked_file.read_at(0, few[..]).unwrap().len, 4usize)
    parked_file.sync().unwrap()

@test("a FileAt over a module var Volume that is not yet mounted answers NotMounted, and works once mounted")
file_at_over_unmounted_volume()
    park_file_c = FileAt(&park_volume_c, new_file(0, 0, 0, 0))
    var few: [4]u8 = [0; 4]
    assert(!park_file_c.is_open())
    assert_eq(park_file_c.read_at(0, few[..]).unwrap_err(), VolumeError.NotMounted)
    assert_eq(park_file_c.sync().unwrap_err(), VolumeError.NotMounted)
    park_dev_c = ram_device(park_disk_c[..])
    format(&park_dev_c, Some(FatType.Fat16)).unwrap()
    park_volume_c = mount(&park_dev_c, park_cache_c[..]).unwrap()
    park_file_c = FileAt(&park_volume_c, park_volume_c.create("B.BIN").unwrap())
    val data = bytes(4, 3)
    assert_eq(park_file_c.write_at(0, data.view()).unwrap(), 4usize)
    assert_eq(park_file_c.extent().unwrap(), 4u64)
