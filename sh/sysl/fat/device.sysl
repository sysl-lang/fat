module sh.sysl.fat

import sysl.slices.copy

// The block device everything in the package is written against: whole sectors, read and written by
// number, and a flush that makes everything written before it durable.
//
// It is a trait and the algorithms are generic over it (`format[D: BlockDevice](dev: *D, ...)`), so an
// SD card driver, a virtio disk, an image file and a test's device that fails on purpose are all just
// implementations. The sector size is the device's: a volume whose boot sector names another is refused
// rather than translated.

// Why a device refused a read, a write or a flush.
enum DeviceError derives Eq, Display
    // A sector at or past the device's end.
    OutOfRange
    // A buffer that is not a whole number of sectors (one sector, for `read` and `write`).
    BadLength
    // The device failed. `code` is the driver's own word for how (an SD card's timeout and its CRC
    // error are two codes), so the cause survives the trip through the volume; 0 when it has none.
    Io(code: u32)

trait BlockDevice
    // The bytes in one sector: 512, 1024, 2048 or 4096.
    sector_size(self) -> usize

    // How many sectors the device has.
    sectors(self) -> u64

    // Copy sector `s` into `out`, which is exactly one sector.
    read(*self, s: u64, out: []u8) -> Result[unit, DeviceError]

    // Write sector `s` from `data`, which is exactly one sector.
    write(*self, s: u64, data: []const u8) -> Result[unit, DeviceError]

    // Copy the sectors from `sector` on into `out`, which is a whole number of them. The whole span is
    // checked before anything is read, an empty one too, and then each sector is read with `read`, in
    // order. A device with a multi-sector command overrides it.
    read_many(*self, sector: u64, out: []u8) -> Result[unit, DeviceError]
        val size = self.sector_size()
        for i in 0..<span(size, self.sectors(), sector, out.len)?
            val at = usize(i) * size
            self.read(sector + i, out[at..<at + size])?
        Ok(())

    // Write the sectors from `sector` on from `bytes`, which is a whole number of them, checked as
    // `read_many` checks and then written with `write`, in order. The volume calls it only once its own
    // buffer is written back, so a device that overrides it still sees writes in program order.
    write_many(*self, sector: u64, bytes: []const u8) -> Result[unit, DeviceError]
        val size = self.sector_size()
        for i in 0..<span(size, self.sectors(), sector, bytes.len)?
            val at = usize(i) * size
            self.write(sector + i, bytes[at..<at + size])?
        Ok(())

    // Everything written before this is durable once it returns.
    flush(*self) -> Result[unit, DeviceError]

// How many sectors `len` bytes from `sector` are, on a device of `total` sectors of `size` bytes: refused
// when they are not whole sectors, or run past the device's end.
private span(size: usize, total: u64, sector: u64, len: usize) -> Result[u64, DeviceError]
    if size == 0 || len % size != 0 then return Err(DeviceError.BadLength)
    val count = u64(len / size)
    if sector > total || count > total - sector then return Err(DeviceError.OutOfRange)
    Ok(count)

// A device in memory, for RAM disks and tests, over storage the caller owns: a static array on a board,
// a `Buf` on the host. It allocates nothing, as nothing else in the package does.
struct RamDevice
    private bytes: []u8
    private size: usize
    private count: u64

    // Every byte the device holds, for a test that looks at the raw image.
    image(self) -> []const u8 = self.bytes

// A device over `storage`, in sectors of `sector_size` bytes: as many whole sectors as it holds, any
// bytes left over unused. Its contents are what `storage` holds; a fresh device for `format` need not
// be zeroed. A `sector_size` of 0 makes a device with no sectors.
ram_device(storage: []u8, sector_size: usize = 512) -> RamDevice
    val count = if sector_size == 0 then 0 else storage.len / sector_size
    RamDevice(storage[..<count * sector_size], sector_size, u64(count))

impl BlockDevice for RamDevice
    sector_size(self) -> usize = self.size
    sectors(self) -> u64 = self.count

    read(*self, s: u64, out: []u8) -> Result[unit, DeviceError]
        if out.len != self.size then return Err(DeviceError.BadLength)
        if s >= self.count then return Err(DeviceError.OutOfRange)
        val at = usize(s) * self.size
        copy(out, self.bytes[at..<at + self.size])
        Ok(())

    write(*self, s: u64, data: []const u8) -> Result[unit, DeviceError]
        if data.len != self.size then return Err(DeviceError.BadLength)
        if s >= self.count then return Err(DeviceError.OutOfRange)
        val at = usize(s) * self.size
        copy(self.bytes[at..<at + self.size], data)
        Ok(())

    flush(*self) -> Result[unit, DeviceError] = Ok(())
