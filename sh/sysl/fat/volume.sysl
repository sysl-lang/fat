module sh.sysl.fat

import sysl.slices.copy
import sysl.text.str_view

// A mounted volume, read: FAT chains, directories, paths and files. Nothing here allocates. The caller
// hands the volume one sector of storage when mounting it, and every read of a FAT entry or a directory
// goes through that one sector; a file's data is read straight into the caller's buffer wherever it
// fills whole sectors of it. Writing is in `write.sysl`.

// Why a volume refused to mount, or an operation on a mounted one — a read, a write, a lookup —
// failed. A device failure is `Device` however it was reached, mounting included; `Boot` is a boot
// sector that was read and refused.
enum VolumeError derives Eq, Display
    Device(error: DeviceError)
    Boot(error: BootError)
    // The buffer handed to `mount` is not one sector of the device's size.
    BadLength
    // A chain names a cluster outside the volume, a free one, or a bad one.
    BadCluster
    // A file's chain ends before its size does.
    ChainTooShort
    // A directory's chain is longer than the volume has clusters, so it runs in a loop.
    ChainLoop
    NotFound
    NotADirectory
    IsADirectory
    // An empty path, or one naming the root where an entry is wanted.
    BadPath
    // A name already in the directory.
    Exists
    // A directory to remove still holds entries.
    NotEmpty
    // No free cluster is left.
    NoSpace
    // FAT16's fixed root directory has no free entries left, and cannot grow.
    RootFull
    // A name no FAT volume can hold: empty, `.` or `..`, longer than 255 UTF-16 units, ending in a space
    // or a dot, or holding a control character or one of `"*/:<>?\|`.
    BadName
    // A write past the largest size a file can have, 4 GiB less one byte.
    TooLarge

impl From[DeviceError] for VolumeError
    from(e: DeviceError) -> VolumeError = VolumeError.Device(e)

// A device that failed while its boot sector was read is `Device`, as it is everywhere else, not a
// boot sector refused.
impl From[BootError] for VolumeError
    from(e: BootError) -> VolumeError = e match
        BootError.Device(d) -> VolumeError.Device(d)
        _ -> VolumeError.Boot(e)

// No sector: what the volume's buffer holds before the first read.
private[fat] const NO_SECTOR: u64 = 0xFFFF_FFFF_FFFF_FFFF

// A file or directory, as its directory entry says: its name, in UTF-8 — the long name when there is
// one, the 8.3 name otherwise — and where its data is.
//
// What the volume reads back when the entry is opened — its attributes, first cluster and size — is
// read-only outside the package, so an entry handed to `open_entry` is the one `read_dir` filled.
struct Entry
    private[fat] name_bytes: [MAX_NAME_BYTES]u8
    private[fat] name_len: usize
    // The 8.3 name, as stored: eight bytes of base and three of extension, space-padded.
    short_name: [11]u8
    private[fat] attribute_bits: u8
    private[fat] start_cluster: u32
    private[fat] byte_count: u32
    created_date: u16
    created_time: u16
    written_date: u16
    written_time: u16
    accessed_date: u16
    // Where the entry is: the sector and offset of its short entry, and the place its run of long-name
    // entries begins at, with the run's length counting the short entry.
    private[fat] sector_at: u64
    private[fat] offset_at: usize
    private[fat] run_cluster: u32
    private[fat] run_index: u32
    private[fat] run_len: u32

    // The name, as a view of the entry's own storage: nothing is copied, so it holds until the entry is
    // filled again.
    name(*self) -> string = str_view(self.name_bytes[0..<self.name_len])

    // The attribute bits (`ATTR_DIRECTORY`, `ATTR_READ_ONLY` and the rest).
    attributes -> u8 = self.attribute_bits

    // The first cluster of its data; 0 for an empty file, and for a `..` entry naming the root.
    first_cluster -> u32 = self.start_cluster

    // Its length in bytes; 0 for a directory.
    size -> u32 = self.byte_count

    is_dir(self) -> bool = self.attribute_bits & ATTR_DIRECTORY != 0
end Entry

// An entry with no name and nothing in it, to be filled by `read_dir`.
empty_entry() -> Entry
    Entry(
        name_bytes = [0; MAX_NAME_BYTES],
        name_len = 0,
        short_name = [0; 11],
        attribute_bits = 0,
        start_cluster = 0,
        byte_count = 0,
        created_date = 0,
        created_time = 0,
        written_date = 0,
        written_time = 0,
        accessed_date = 0,
        sector_at = 0,
        offset_at = 0,
        run_cluster = 0,
        run_index = 0,
        run_len = 0,
    )

// A place in a directory, and the long name being gathered there. `read_dir` moves it on one entry at a
// time.
struct Dir
    // The cluster being read, or 0 for FAT16's fixed root directory.
    private[fat] cluster: u32
    // The entry within the cluster (or within the fixed root) to read next.
    private index: u32
    // The clusters followed so far, to catch a chain that loops.
    private steps: u32
    private finished: bool
    // The long name gathered so far: its UTF-16 units, the order number the next entry of its run must
    // have (0 when the run is complete or there is none), the run's length, and its checksum.
    private units: [MAX_NAME_UNITS]u16
    private expect: u8
    private pieces: u8
    private checksum: u8
    // Where the run of long-name entries being gathered began.
    private run_cluster: u32
    private run_index: u32

    // Forget any long name being gathered.
    private drop_long_name(*self)
        self.expect = 0
        self.pieces = 0
end Dir

private[fat] dir_at(cluster: u32) -> Dir
    Dir(
        cluster = cluster,
        index = 0,
        steps = 0,
        finished = false,
        units = [0; MAX_NAME_UNITS],
        expect = 0,
        pieces = 0,
        checksum = 0,
        run_cluster = 0,
        run_index = 0,
    )

// An open file: where its data is, how long it is, and where the next read begins. Only the volume
// changes them: a size or a cluster set from outside would send the next read or write astray.
struct File
    private[fat] start_cluster: u32
    private[fat] byte_count: u32
    private[fat] at: u32
    // The cluster last read or written, and which cluster of the chain it is; 0 when there is none yet.
    private[fat] cluster: u32
    private[fat] cluster_index: u32
    // Where its directory entry is, which a write keeps up to date.
    private[fat] entry_sector: u64
    private[fat] entry_offset: usize

    // The first cluster of its data; 0 while it is empty.
    first_cluster -> u32 = self.start_cluster

    // Its length in bytes.
    size -> u32 = self.byte_count

    // Where the next read begins.
    position(self) -> u32 = self.at

    // Move to `position`, or to the end where it is past it.
    seek(*self, position: u32)
        self.at = if position < self.size then position else self.size
end File

private[fat] file_of(e: *Entry) -> File = new_file(e.first_cluster, e.size, e.sector_at, e.offset_at)

// A file at its start, with no cluster of its chain visited yet.
private[fat] new_file(first_cluster: u32, size: u32, entry_sector: u64, entry_offset: usize) -> File
    File(
        start_cluster = first_cluster,
        byte_count = size,
        at = 0,
        cluster = 0,
        cluster_index = 0,
        entry_sector = entry_sector,
        entry_offset = entry_offset,
    )

struct Volume[D: BlockDevice]
    private[fat] dev: *D
    private[fat] layout: Geometry
    private[fat] sector: []u8
    private[fat] loaded: u64
    // Whether the buffer holds a write not yet made to the device.
    private[fat] dirty: bool
    // Whether a FAT entry is written to every copy of the FAT: true but where FAT32's flags turn
    // mirroring off.
    private[fat] mirrored: bool
    // FAT32's FSInfo, kept in memory and written by `flush`: its sector (0 where there is none, or it
    // was not valid), the free cluster count (`FSINFO_UNKNOWN` when not known), the cluster a search for
    // a free one starts at, and whether either has changed.
    private[fat] info_sector: u32
    private[fat] free_count: u32
    private[fat] next_free: u32
    private[fat] info_dirty: bool
    private[fat] clock: Option[*Clock]

    // Where everything on the volume is, as its boot sector says. Read-only: the volume's reads and
    // writes are placed by it.
    geometry -> Geometry = self.layout

    // The root directory, from its first entry.
    root(*self) -> Dir = dir_at(if self.layout.fat_type == FatType.Fat32 then self.layout.root_cluster else 0)

    // Have the volume's buffer hold sector `s`.
    private[fat] load(*self, s: u64) -> Result[unit, VolumeError]
        if self.loaded == s then return Ok(())
        self.write_back()?
        self.loaded = NO_SECTOR
        self.dev.read(s, self.sector)?
        self.loaded = s
        Ok(())

    // Whether `c` is a cluster this volume has.
    private[fat] holds(self, c: u32) -> bool = c >= 2 && c <= self.geometry.last_cluster()

    // The cluster after `c` in its chain, or `None` at the chain's end. A free, bad or reserved entry
    // inside a chain is an error, as is one naming a cluster past the volume's last.
    private[fat] next_cluster(*self, c: u32) -> Result[Option[u32], VolumeError]
        if !self.holds(c) then return Err(VolumeError.BadCluster)
        val entry = self.fat_entry(c)?
        val end_of_chain = if self.geometry.fat_type == FatType.Fat32 then CHAIN_END_MIN32 else CHAIN_END_MIN16
        if entry >= end_of_chain then return Ok(None)
        if !self.holds(entry) then return Err(VolumeError.BadCluster)
        Ok(Some(entry))

    // Load the FAT sector holding cluster `c`'s entry, and answer where in it the entry is.
    private[fat] load_entry(*self, c: u32) -> Result[usize, VolumeError]
        val g = self.geometry
        val offset = u64(c) * (if g.fat_type == FatType.Fat32 then 4 else 2)
        val bps = u64(g.bytes_per_sector)
        self.load(u64(g.fat_start(g.active_fat)) + offset / bps)?
        // An entry never straddles two sectors: 2 and 4 both divide every sector size.
        Ok(usize(offset % bps))

    // Cluster `c`'s FAT entry as it stands: FAT32's are 28 bits, and the top four, reserved, are left off.
    private[fat] fat_entry(*self, c: u32) -> Result[u32, VolumeError]
        val at = self.load_entry(c)?
        val s = self.sector
        val low = u32(s[at]) | u32(s[at + 1]) << 8
        if self.geometry.fat_type == FatType.Fat32 then return Ok((low | u32(s[at + 2]) << 16 | u32(s[at + 3]) << 24) & 0x0FFF_FFFF)
        Ok(low)

    // Fill `e` with the next entry of `d`, answering false at the directory's end. Free entries, the
    // volume label and long-name entries are passed over; a long name is the name of the short entry
    // after it only if its run is whole and its checksum is that entry's, and is dropped otherwise, as
    // every reader does. `.` and `..` are entries like any other.
    read_dir(*self, d: *Dir, e: *Entry) -> Result[bool, VolumeError]
        val g = self.geometry
        val per_sector = g.bytes_per_sector / 32
        loop
            if d.finished then return Ok(false)
            var sector = 0u64
            if d.cluster == 0
                if d.index >= g.root_entries
                    d.finished = true
                    return Ok(false)
                sector = u64(g.root_dir_start() + d.index / per_sector)
            else
                if d.index == g.cluster_bytes() / 32
                    self.next_cluster(d.cluster)? match
                        Some(n) ->
                            d.steps += 1
                            if d.steps >= g.clusters then return Err(VolumeError.ChainLoop)
                            d.cluster = n
                            d.index = 0
                        None ->
                            d.finished = true
                            return Ok(false)
                sector = u64(g.cluster_start(d.cluster) + d.index / per_sector)
            self.load(sector)?
            val offset = usize(d.index % per_sector) * 32
            val raw: *DirEntry = at(self.sector, offset)
            d.index += 1

            val first = raw.name[0]
            if first == ENTRY_END
                d.finished = true
                return Ok(false)
            if first == ENTRY_FREE
                d.drop_long_name()
                continue
            if raw.attributes & ATTR_LONG_NAME_MASK == ATTR_LONG_NAME
                gather(d, at(self.sector, offset))
                continue
            if raw.attributes & ATTR_VOLUME_ID != 0
                d.drop_long_name()
                continue

            e.short_name = raw.name
            e.attribute_bits = raw.attributes
            e.start_cluster = if g.fat_type == FatType.Fat32 then u32(raw.first_cluster_high) << 16 | u32(raw.first_cluster_low)
                              else u32(raw.first_cluster_low)
            e.byte_count = raw.size
            e.created_date = raw.created_date
            e.created_time = raw.created_time
            e.written_date = raw.written_date
            e.written_time = raw.written_time
            e.accessed_date = raw.accessed_date
            val whole = d.pieces != 0 && d.expect == 0 && d.checksum == short_name_checksum(raw.name)
            e.name_len = if whole then utf16_to_utf8(d.units[0..<usize(d.pieces) * 13], e.name_bytes[..])
                         else short_display(raw.name, raw.nt_reserved, e.name_bytes[..])
            e.sector_at = sector
            e.offset_at = offset
            e.run_cluster = if whole then d.run_cluster else d.cluster
            e.run_index = if whole then d.run_index else d.index - 1
            e.run_len = if whole then u32(d.pieces) + 1 else 1
            d.drop_long_name()
            return Ok(true)

    // The directory an entry names. A `..` entry naming the root has cluster 0, and so does FAT16's
    // root; FAT32's root is a cluster like any other.
    open_dir_entry(*self, e: *Entry) -> Result[Dir, VolumeError]
        if !e.is_dir() then return Err(VolumeError.NotADirectory)
        if e.first_cluster == 0 then return Ok(self.root())
        if !self.holds(e.first_cluster) then return Err(VolumeError.BadCluster)
        Ok(dir_at(e.first_cluster))

    // The file an entry names.
    open_entry(*self, e: *Entry) -> Result[File, VolumeError]
        if e.is_dir() then return Err(VolumeError.IsADirectory)
        if e.size != 0 && !self.holds(e.first_cluster) then return Err(VolumeError.BadCluster)
        Ok(file_of(e))

    // Fill `e` with the entry `path` names: names separated by `/`, a leading `/` or none, each matched
    // against both an entry's long name and its 8.3 one without regard to the case of ASCII letters. `.`
    // is the directory it is in, and `..` its parent (the root's is the root).
    find(*self, path: string, e: *Entry) -> Result[unit, VolumeError]
        var d = self.root()
        var at_root = true
        var found = false
        var short: [48]u8 = [0; 48]
        var i = 0usize
        while i < path.len
            if path[i] == u8('/')
                i += 1
                continue
            var j = i
            while j < path.len && path[j] != u8('/')
                j += 1
            val part = path[i..<j]
            i = j
            if part == "." then continue
            if part == ".." && at_root then continue
            if found
                d = self.open_dir_entry(e)?
            var matched = false
            while !matched && self.read_dir(&d, e)?
                val n = short_display(e.short_name, 0, short[..])
                matched = same_name(e.name_bytes[0..<e.name_len], part) || same_name(short[0..<n], part)
            if !matched then return Err(VolumeError.NotFound)
            found = true
            // A `..` naming the root says cluster 0; some writers put FAT32's root cluster there instead.
            at_root = e.is_dir() && (e.first_cluster == 0 || e.first_cluster == self.geometry.root_cluster)
        if !found then return Err(VolumeError.BadPath)
        Ok(())

    // The directory `path` names; an empty path, or `/`, is the root.
    open_dir(*self, path: string) -> Result[Dir, VolumeError]
        var e = empty_entry()
        self.find(path, &e) match
            Ok(()) -> self.open_dir_entry(&e)
            Err(VolumeError.BadPath) -> Ok(self.root())
            Err(other) -> Err(other)

    // The file `path` names.
    open(*self, path: string) -> Result[File, VolumeError]
        var e = empty_entry()
        self.find(path, &e)?
        self.open_entry(&e)

    // Read from `f` into `out` from its position on, answering how many bytes were read: as many as
    // `out` holds, or fewer at the file's end, where it answers 0.
    read(*self, f: *File, out: []u8) -> Result[usize, VolumeError]
        val g = self.geometry
        val bps = g.bytes_per_sector
        val cluster_bytes = g.cluster_bytes()
        var done = 0usize
        while done < out.len && f.at < f.size
            // The cluster holding the position: walked from the one last read when it is at or before
            // it, from the chain's start otherwise.
            val want = f.at / cluster_bytes
            if f.cluster == 0 || want < f.cluster_index
                if !self.holds(f.first_cluster) then return Err(VolumeError.BadCluster)
                f.cluster = f.first_cluster
                f.cluster_index = 0
            while f.cluster_index < want
                self.next_cluster(f.cluster)? match
                    Some(n) ->
                        f.cluster = n
                        f.cluster_index += 1
                    None -> return Err(VolumeError.ChainTooShort)
            val within = f.at % cluster_bytes
            val sector = u64(g.cluster_start(f.cluster) + within / bps)
            val offset = within % bps
            var n = bps - offset
            if u64(n) > u64(out.len - done) then n = u32(out.len - done)
            if n > f.size - f.at then n = f.size - f.at
            if offset == 0
                var span = cluster_bytes - within
                if u64(span) > u64(out.len - done) then span = u32(out.len - done)
                if span > f.size - f.at then span = f.size - f.at
                span = (span / bps) * bps
                // Never bypass a dirty cached sector inside the proposed run.
                if span >= bps && !(self.dirty && self.loaded >= sector && self.loaded < sector + u64(span / bps)) then n = span
            val into = out[done..<done + usize(n)]
            // A sector the buffer holds may have a write in it the device has not seen.
            if n >= bps && (n > bps || self.loaded != sector)
                self.dev.read_many(sector, into)?
            else
                self.load(sector)?
                copy(into, self.sector[usize(offset)..<usize(offset + n)])
            f.at += n
            done += usize(n)
        Ok(done)
end Volume

// Take a part of `e`'s run of long-name entries into `d`'s gathered name. A run begins at the entry
// marked last; each entry after it must number one less and carry the same checksum, or what was
// gathered is dropped. An entry that is not part of a run in progress is passed over.
private gather(d: *Dir, l: *LongNameEntry)
    val order = l.order & LONG_ORDER_MASK
    if l.order & LAST_LONG_ENTRY != 0
        if order == 0 || usize(order) * 13 > MAX_NAME_UNITS
            d.drop_long_name()
            return
        d.pieces = order
        d.checksum = l.checksum
        d.run_cluster = d.cluster
        d.run_index = d.index - 1
    else if d.expect == 0 || order != d.expect || l.checksum != d.checksum
        d.drop_long_name()
        return
    val base = (usize(order) - 1) * 13
    for k in 0..<5
        d.units[base + k] = l.name1[k].unit
    for k in 0..<6
        d.units[base + 5 + k] = l.name2[k].unit
    for k in 0..<2
        d.units[base + 11 + k] = l.name3[k].unit
    d.expect = order - 1

// Mount the volume on `dev`, reading and writing through `sector`, which is one sector of the device's
// size and is the volume's from now on.
mount[D: BlockDevice](dev: *D, sector: []u8) -> Result[Volume[D], VolumeError]
    if sector.len != dev.sector_size() then return Err(VolumeError.BadLength)
    val g = read_geometry(dev, sector)?
    // The boot sector is still in the buffer: bit 7 of FAT32's flags turns mirroring off.
    val tail: *Fat32Tail = at(sector, TAIL_OFFSET)
    val mirrored = g.fat_type != FatType.Fat32 || tail.ext_flags & 0x80 == 0
    var v = Volume(
        dev = dev,
        layout = g,
        sector = sector,
        loaded = NO_SECTOR,
        dirty = false,
        mirrored = mirrored,
        info_sector = 0,
        free_count = FSINFO_UNKNOWN,
        next_free = 2,
        info_dirty = false,
        clock = None,
    )
    v.read_fs_info()?
    Ok(v)
