// The gate's proof that the package runs where there is no operating system: a program that formats and
// reads back a volume over a device in static memory, built as an archive for each freestanding CPU
// family. A library build alone proves too little, since it never checks the body of a generic function
// nothing has instantiated.

package {
  name    = "portable"
  version = "0.0.1"
}

dependencies {
  fat { workspace = true }
}
