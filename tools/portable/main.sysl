// Formats a volume over a device in static memory, then mounts it, writes a directory and a file into it,
// lists its root, reads the file back and at offsets, renames and removes it: the whole package, instantiated with no
// operating system underneath.

import device.StaticDevice
import sh.sysl.fat.{FatType, FileAt, empty_entry, format, mount}
import sysl.io.{ReadAt, WriteAt}

@export("main")
probe() -> i32
    var dev = StaticDevice(20000)
    val made = format(&dev, Some(FatType.Fat16), label = "PROBE")
    if made.is_err() then return 1
    var scratch: [512]u8 = [0; 512]
    var v = mount(&dev, scratch[..]) match
        Ok(v) -> v
        Err(_) -> return 2
    if v.make_dir("/boot").is_err() then return 3
    var w = v.create("/boot/kernel.img") match
        Ok(f) -> f
        Err(_) -> return 4
    val data: [64]u8 = [7; 64]
    if v.write(&w, data[..]).is_err() || v.truncate(&w, 32).is_err() then return 5
    var d = v.root()
    var e = empty_entry()
    var listed = 0
    while v.read_dir(&d, &e) == Ok(true)
        listed += 1
    var f = v.open("/boot/kernel.img") match
        Ok(f) -> f
        Err(_) -> return i32(listed)
    var out: [64]u8 = [0; 64]
    val got = v.read(&f, out[..]) match
        Ok(n) -> i32(n)
        Err(_) -> return 6
    var at = FileAt(&v, f)
    val run: [2048]u8 = [9; 2048]
    if at.write_at(1024, run[..]).is_err() || at.read_at(512, out[..]).is_err() || at.sync().is_err() then return 9
    if v.rename("/boot/kernel.img", "/boot/Kernel Image.img").is_err() then return 7
    if v.remove("/boot/kernel image.img").is_err() || v.remove_dir("/boot").is_err() || v.flush().is_err() then return 8
    got
